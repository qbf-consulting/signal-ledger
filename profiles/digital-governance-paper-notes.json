{
  "id": "digital-governance-paper-notes",
  "title": "Digital Governance Paper Notes",
  "purpose": "Discover research candidates for human editorial review without narrowing discovery to prior interests.",
  "source_policy": {
    "preferred_classes": [
      "research",
      "primary",
      "analysis"
    ],
    "authority_expectations": [
      "A review candidate must retain a canonical paper URI and observation provenance.",
      "Editorial review is downstream analysis, not primary evidence for the paper's claims."
    ]
  },
  "relevance": {
    "include_terms": [
      "digital governance",
      "digital public infrastructure",
      "digital identity",
      "platform governance",
      "AI governance",
      "trust infrastructure",
      "public interest technology"
    ],
    "exclude_terms": [
      "retracted without contextual value"
    ]
  },
  "significance_dimensions": [
    "novelty",
    "governance_impact",
    "research_significance",
    "evidence_strength",
    "geographic_scope"
  ],
  "discovery": {
    "channels": [
      "known-author",
      "known-venue",
      "citation-neighbourhood",
      "topic-query",
      "external-curation",
      "exploration-sample"
    ],
    "candidate_lanes": [
      "established-interest",
      "adjacent-domain",
      "exploratory",
      "counter-thesis"
    ]
  },
  "output": {
    "semantics": "Candidate discovery and triage only; publication remains a human editorial decision.",
    "handoff_schema": "signal-ledger.research-candidate.v1"
  }
}
