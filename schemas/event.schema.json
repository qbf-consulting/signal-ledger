{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"Signal Ledger Event",
  "type":"object",
  "additionalProperties":false,
  "required":["id","reconciliation_key","title","observation_ids","entities","state"],
  "properties":{
    "id":{"type":"string","pattern":"^[a-z][a-z0-9._-]{2,127}$"},
    "reconciliation_key":{"type":"string","minLength":1},
    "title":{"type":"string","minLength":1},
    "observation_ids":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string"}},
    "entities":{"type":"array","items":{"type":"object"}},
    "state":{"enum":["new","changed","confirmed","superseded"]}
  }
}
